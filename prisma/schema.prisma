// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Roles {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  users     Users[]

  @@map("roles")
}

model Users {
  id           String      @id @default(uuid())
  name         String?
  email        String      @unique
  role         Roles?      @relation(fields: [roleId], references: [id])
  roleId       String?     @map("role_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  cashierSales Sales[]     @relation("CashierSales")
  userSales    Sales[]     @relation("UserSales")
  shift        Shift[]     @relation("CashierShifts")
  auditLogs    AuditLogs[]

  @@map("users")
}

model Stores {
  id               String             @id @default(uuid())
  name             String
  address          String
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  inventory        Inventories[]
  sales            Sales[]
  purchases        Purchases[]
  stockAdjustments StockAdjustments[]
  expenses         Expenses[]
  shifts           Shift[]

  @@map("stores")
}

model Categories {
  id        String     @id @default(uuid())
  name      String?
  parentId  String?    @map("parent_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  products  Products[]

  @@map("categories")
}

model Suppliers {
  id          String      @id @default(uuid())
  name        String?
  phoneNumber String?     @map("phone_number")
  address     String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  products    Products[]
  purchases   Purchases[]

  @@map("suppliers")
}

model Products {
  id                   String                 @id @default(uuid())
  name                 String
  barcode              String?                @unique
  category             Categories?            @relation(fields: [categoryId], references: [id])
  categoryId           String?                @map("category_id")
  supplier             Suppliers?             @relation(fields: [supplierId], references: [id])
  supplierId           String?                @map("supplier_id")
  isActive             Boolean                @default(true) @map("is_active")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  variants             ProductVariants[]
  saleItems            SaleItems[]
  PurchasesItem        PurchasesItems[]
  stockAdjustmentItems StockAdjustmentItems[]
  productPrices        ProductPrices[]

  @@map("products")
}

model ProductVariants {
  id         String        @id @default(uuid())
  product    Products      @relation(fields: [productId], references: [id])
  productId  String        @map("product_id")
  sku        String        @unique
  barcode    String?       @unique
  constPrice Decimal?      @map("const_price")
  sellPrice  Decimal?      @map("sell_price")
  skuId      String?       @unique @map("sku_id")
  isActive   Boolean       @default(true) @map("is_active")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  inventory  Inventories[]

  @@map("product_variants")
}

model Inventories {
  id               String          @id @default(uuid())
  store            Stores          @relation(fields: [storeId], references: [id])
  storeId          String          @map("store_id")
  productVariant   ProductVariants @relation(fields: [productVariantId], references: [id])
  productVariantId String          @map("product_variant_id")
  stock            Decimal         @default(0) @map("stock")
  minStock         Decimal         @default(0) @map("min_stock")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@map("inventories")
}

model TypeStockMovements {
  id            String           @id @default(uuid())
  name          String           @unique
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  MovementStock StockMovements[]

  @@map("type_movement_stocks")
}

model StockMovements {
  id                  String             @id @default(uuid())
  productId           String             @map("product_id")
  storeId             String             @map("store_id")
  quantity            Decimal            @map("quantity")
  typeMovementStock   TypeStockMovements @relation(fields: [typeMovementStockId], references: [id])
  typeMovementStockId String             @map("type_movement_stock_id")
  referenceId         String?            @map("reference_id")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  @@map("movement_stocks")
}

model Customers {
  id        String   @id @default(uuid())
  name      String
  phone     String?  @map("phone")
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  sales     Sales[]

  @@map("customers")
}

model StatusSales {
  id        String      @id @default(uuid())
  name      String      @unique
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  sales     Sales[]
  purchases Purchases[]

  @@map("status_sales")
}

model Sales {
  id           String       @id @default(uuid())
  invoice      String       @unique
  storeId      String       @map("store_id")
  store        Stores       @relation(fields: [storeId], references: [id])
  cashierId    String       @map("cashier_id")
  cashier      Users        @relation(fields: [cashierId], references: [id], name: "CashierSales")
  user         Users?       @relation(fields: [userId], references: [id], name: "UserSales")
  userId       String?      @map("user_id")
  customer     Customers?   @relation(fields: [customerId], references: [id])
  customerId   String?
  subtotal     Decimal      @map("subtotal")
  discount     Decimal      @map("discount")
  tax          Decimal      @map("tax")
  total        Decimal      @map("total")
  StatusSale   StatusSales? @relation(fields: [StatusSaleId], references: [id])
  StatusSaleId String?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  items        SaleItems[]
  payments     Payments[]
  receipts     Receipts[]

  @@map("sales")
}

model SaleItems {
  id          String   @id @default(uuid())
  saleId      String   @map("sale_id")
  sale        Sales    @relation(fields: [saleId], references: [id])
  productId   String   @map("product_id")
  product     Products @relation(fields: [productId], references: [id])
  productName String   @map("product_name")
  price       Decimal  @map("price")
  quantity    Decimal  @map("quantity")
  discount    Decimal  @map("discount")
  total       Decimal  @map("total")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("sale_items")
}

model PaymentMethod {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  payments  Payments[]

  @@map("payment_methods")
}

model Payments {
  id        String        @id @default(uuid())
  saleId    String        @map("sale_id")
  sale      Sales         @relation(fields: [saleId], references: [id])
  methodId  String        @map("method_id")
  method    PaymentMethod @relation(fields: [methodId], references: [id])
  amount    Decimal       @map("amount")
  paidAt    DateTime      @default(now()) @map("paid_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@map("payments")
}

model Purchases {
  id            String           @id @default(uuid())
  supplierId    String           @map("supplier_id")
  supplier      Suppliers        @relation(fields: [supplierId], references: [id])
  storeId       String           @map("store_id")
  store         Stores           @relation(fields: [storeId], references: [id])
  total         Decimal          @map("total")
  statusId      String           @map("status_id")
  status        StatusSales      @relation(fields: [statusId], references: [id])
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  PurchasesItem PurchasesItems[]
}

model PurchasesItems {
  id         String    @id @default(uuid())
  purchaseId String    @map("purchase_id")
  purchase   Purchases @relation(fields: [purchaseId], references: [id])
  productId  String    @map("product_id")
  product    Products  @relation(fields: [productId], references: [id])
  price      Decimal   @map("price")
  quantity   Decimal   @map("quantity")
  total      Decimal   @map("total")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("purchases_items")
}

model StockAdjustments {
  id        String                 @id @default(uuid())
  storeId   String                 @map("store_id")
  store     Stores                 @relation(fields: [storeId], references: [id])
  reason    String?                @map("reason")
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")
  items     StockAdjustmentItems[]

  @@map("stock_adjustments")
}

model StockAdjustmentItems {
  id                String           @id @default(uuid())
  stockAdjustmentId String           @map("stock_adjustment_id")
  stockAdjustment   StockAdjustments @relation(fields: [stockAdjustmentId], references: [id])
  productId         String           @map("product_id")
  product           Products         @relation(fields: [productId], references: [id])
  quantity          Decimal          @map("quantity")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@map("stock_adjustment_items")
}

model Expenses {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  store     Stores   @relation(fields: [storeId], references: [id])
  title     String   @map("title")
  amount    Decimal
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("expenses")
}

model Shift {
  id          String    @id @default(uuid())
  cashierId   String    @map("cashier_id")
  cashier     Users     @relation(fields: [cashierId], references: [id], name: "CashierShifts")
  storeId     String    @map("store_id")
  store       Stores    @relation(fields: [storeId], references: [id])
  openedAt    DateTime  @map("opened_at")
  closedAt    DateTime? @map("closed_at")
  openingCash Decimal   @map("opening_cash")
  closingCash Decimal?  @map("closing_cash")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("shifts")
}

model Receipts {
  id        String   @id @default(uuid())
  saleId    String   @map("sale_id")
  sale      Sales    @relation(fields: [saleId], references: [id])
  printedAt DateTime @default(now()) @map("printed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("receipts")
}

model Taxes {
  id        String   @id @default(uuid())
  name      String   @unique
  rate      Decimal  @map("rate")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("taxes")
}

model Discounts {
  id        String       @id @default(uuid())
  name      String       @unique
  type      DiscountType @map("type")
  value     Decimal      @map("value")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("discounts")
}

model ProductPrices {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  product   Products @relation(fields: [productId], references: [id])
  price     Decimal  @map("price")
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("product_prices")
}

model BarcodeLogs {
  id        String   @id @default(uuid())
  barcode   String   @map("barcode")
  scannedAt DateTime @default(now()) @map("scanned_at")

  @@map("barcode_log")
}

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @map("value")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model AuditLogs {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      Users?   @relation(fields: [userId], references: [id])
  action    String   @map("action")
  tableName String   @map("table_name")
  recordId  String   @map("record_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
